# Origen del backend; por defecto se usa http://localhost:8080 en desarrollo.
VITE_API_URL=http://localhost:8080
# Mantener sincronizado con MERCADOPAGO_OAUTH_ENABLED del backend.
VITE_MERCADOPAGO_OAUTH_ENABLED=false

# Clave pública restringida por dominio para Maps JavaScript API y Places API (New)
VITE_GOOGLE_MAPS_API_KEY=
