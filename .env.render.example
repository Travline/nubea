# Variables del backend en Render (Environment del servicio web).
# Plantilla SIN secretos: sustituir los marcadores <...> en el panel de Render; nunca guardar valores reales en el repositorio.
# Guía: docs/despliegue/render-backend.md · Pagos: docs/technical/pagos-operacion.md · Estado: docs/revision/estado-backend.md
# Render define PORT automáticamente: no configurarla.

# ===================================================================
# Base de datos (Supabase, Session pooler, puerto 5432)
# ===================================================================
# No usar el Transaction pooler (6543): rompe prepared statements y advisory locks.
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST_SESSION_POOLER>:5432/postgres?sslmode=require
# Usuario con permisos de migración (Flyway aplica V1–V14 al arrancar).
SPRING_DATASOURCE_USERNAME=<USUARIO_POSTGRES>
SPRING_DATASOURCE_PASSWORD=<SECRETO>

# ===================================================================
# Sesión, cookies y CORS
# ===================================================================
# true siempre en HTTPS. Obligatorio con SameSite=None: el navegador descarta cookies None sin Secure.
SESSION_COOKIE_SECURE=true
# none: el frontend (https://nubea.vercel.app) y la API (https://nubea.onrender.com) son SITIOS distintos.
# Con lax el navegador no envía la cookie de sesión en las peticiones del frontend a la API y el login falla.
# Se aplica también a la cookie CSRF. Ver docs/despliegue/render-backend.md §4.
# Solo usar lax si frontend y API pasan a servirse bajo el mismo sitio (por ejemplo, dominio propio con subdominios).
SESSION_COOKIE_SAME_SITE=none
# Orígenes exactos del frontend, separados por comas, sin barra final. Nunca "*".
APP_CORS_ALLOWED_ORIGINS=https://nubea.vercel.app
# Dejar vacío: el registro no verifica el correo. Asignar el primer admin por SQL (render-backend.md §5).
APP_BOOTSTRAP_ADMIN_EMAIL=

# ===================================================================
# Almacenamiento de imágenes (Supabase Storage, API S3)
# ===================================================================
# Copiar el valor real del panel (Storage → S3); forma: https://<REFERENCIA>.storage.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=https://<REFERENCIA>.storage.supabase.co/storage/v1/s3
# Región que indique el panel (us-east-1 es solo un ejemplo).
STORAGE_S3_REGION=<REGION_DEL_PROYECTO>
STORAGE_S3_BUCKET=nubea
STORAGE_S3_ACCESS_KEY=<ACCESS_KEY_S3>
STORAGE_S3_SECRET_KEY=<SECRETO>
# Base pública del bucket, sin barra final.
STORAGE_PUBLIC_BASE_URL=https://<REFERENCIA>.supabase.co/storage/v1/object/public/nubea
# Opcional: frecuencia (ms) de la limpieza diferida de archivos.
STORAGE_CLEANUP_DELAY_MS=60000

# ===================================================================
# Inicio de sesión con Google (Google Identity Services, RN-M1-05)
# ===================================================================
# ID de cliente OAuth "Aplicación web" de Google Cloud. No es secreto (es el mismo que VITE_GOOGLE_CLIENT_ID en Vercel).
# En Google Cloud basta con "Orígenes de JavaScript autorizados" = https://nubea.vercel.app (sin URIs de redirección).
# Vacío = deshabilitado (503 GOOGLE_NO_DISPONIBLE). Mientras la pantalla de consentimiento esté en modo prueba,
# solo pueden entrar los usuarios de prueba añadidos en Google Cloud.
GOOGLE_CLIENT_ID=<CLIENT_ID>.apps.googleusercontent.com

# ===================================================================
# Mercado Pago · Vinculación OAuth de vendedores
# ===================================================================
MERCADOPAGO_OAUTH_ENABLED=true
MERCADOPAGO_OAUTH_CLIENT_ID=<CLIENT_ID_APLICACION_NUBEA>
MERCADOPAGO_OAUTH_CLIENT_SECRET=<SECRETO>
MERCADOPAGO_OAUTH_AUTHORIZATION_URL=https://auth.mercadopago.com.pe/authorization
MERCADOPAGO_OAUTH_TOKEN_URL=https://api.mercadopago.com/oauth/token
# Debe coincidir EXACTAMENTE con la Redirect URL registrada en la aplicación de Mercado Pago.
MERCADOPAGO_OAUTH_CALLBACK_URL=https://nubea.onrender.com/api/integraciones/mercado-pago/oauth/callback
MERCADOPAGO_OAUTH_RETORNO_PANEL=https://nubea.vercel.app/plataforma/panel/retorno-pago
MERCADOPAGO_OAUTH_EXPIRY_MINUTES=10
# Clave de cifrado de los tokens de los vendedores. Generar UNA vez con: openssl rand -base64 32
# Si se pierde, hay que volver a vincular todas las tiendas. Para rotar: añadir K2, cambiar ACTIVE_KEY y conservar K1.
MERCADOPAGO_OAUTH_ACTIVE_KEY=k1
MERCADOPAGO_OAUTH_KEYS_K1=<SECRETO_BASE64_32_BYTES>
MERCADOPAGO_OAUTH_ALLOW_INSECURE_LOCALHOST=false
# Opcional: frecuencia (ms) de renovación de tokens.
MERCADOPAGO_OAUTH_RENEWAL_DELAY_MS=60000

# ===================================================================
# Mercado Pago · Pagos y notificaciones
# ===================================================================
# Crea checkout, procesador de pagos y conciliación. Requiere OAuth.
MERCADOPAGO_PAGOS_ENABLED=true
# Compras nuevas. false conserva conciliación y reembolsos.
MERCADOPAGO_PAGOS_CHECKOUT_ENABLED=true
# En producción, usar true para habilitar cobros reales en todas las tiendas con cuenta activa.
MERCADOPAGO_PAGOS_PRODUCCION_GLOBAL=false
# Solo se usa con PRODUCCION_GLOBAL=false. Dejar vacía en producción.
MERCADOPAGO_PAGOS_TIENDAS=<UUID_TIENDA_PRUEBA>:PRUEBA
# Origen HTTPS del frontend para las URLs de retorno del comprador.
MERCADOPAGO_PAGOS_STORE_ORIGIN=https://nubea.vercel.app
MERCADOPAGO_PAGOS_DELAY_MS=5000
# Webhook de Orders registrado en Mercado Pago: https://nubea.onrender.com/api/publico/mercadopago/notificaciones (evento Order)
MERCADOPAGO_NOTIFICACIONES_ENABLED=true
# Clave secreta de la firma del webhook (panel de Mercado Pago). Sin ella el backend no arranca con notificaciones habilitadas.
MERCADOPAGO_NOTIFICACIONES_SECRET=<SECRETO>

# ===================================================================
# Reservas (siempre activo, con o sin pagos)
# ===================================================================
# Opcionales: frecuencia del vencimiento y gracia para creaciones de orden inciertas (> 30 min).
RESERVAS_VENCIMIENTO_DELAY_MS=60000
RESERVAS_VENCIMIENTO_GRACIA_MINUTOS=40
