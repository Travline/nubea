# Variables de entorno de ejemplo; proporcionar secretos mediante el entorno de despliegue.
# Render define PORT automáticamente; local usa 8080 si no se configura.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Usar false únicamente en desarrollo local sin HTTPS.
SESSION_COOKIE_SECURE=true
# Para frontend en otro sitio: none, siempre con HTTPS y cookies Secure.
SESSION_COOKIE_SAME_SITE=lax
APP_CORS_ALLOWED_ORIGINS=
# Correo de una cuenta ya registrada; retirar tras inicializar el primer administrador.
APP_BOOTSTRAP_ADMIN_EMAIL=
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=nubea
# Base pública del CDN; en local, habilitar lectura pública únicamente en el bucket de desarrollo.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/nubea
MERCADOPAGO_OAUTH_ENABLED=false
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_OAUTH_AUTHORIZATION_URL=https://auth.mercadopago.com.pe/authorization
MERCADOPAGO_OAUTH_TOKEN_URL=https://api.mercadopago.com/oauth/token
MERCADOPAGO_OAUTH_CALLBACK_URL=
MERCADOPAGO_OAUTH_RETORNO_PANEL=http://localhost:3000/plataforma/panel/retorno-pago
MERCADOPAGO_OAUTH_EXPIRY_MINUTES=10
MERCADOPAGO_OAUTH_ACTIVE_KEY=k1
MERCADOPAGO_OAUTH_KEYS_K1=
# Solo desarrollo local: permite URLs http://localhost en OAuth. Nunca en producción.
MERCADOPAGO_OAUTH_ALLOW_INSECURE_LOCALHOST=false
# Frecuencia (ms) de la renovación de tokens OAuth de los vendedores.
MERCADOPAGO_OAUTH_RENEWAL_DELAY_MS=60000

# --- Cobros con Mercado Pago (Orders / Checkout Pro). Ver docs/technical/pagos-operacion.md ---
# Crea la API de checkout, el procesador de pagos y la conciliación. Requiere OAuth configurado.
MERCADOPAGO_PAGOS_ENABLED=false
# Permite compras nuevas. Con false se conservan conciliación y reembolsos de pedidos existentes.
MERCADOPAGO_PAGOS_CHECKOUT_ENABLED=false
# Lista blanca de tiendas que pueden cobrar y su ambiente: <UUID_TIENDA>:PRUEBA o <UUID_TIENDA>:PRODUCCION, separadas por comas.
MERCADOPAGO_PAGOS_TIENDAS=
# Origen HTTPS del frontend para las URLs de retorno del comprador (/tienda/<slug>/pedidos/<id>).
# Se valida al arrancar aunque los pagos estén deshabilitados: debe ser HTTPS, sin ruta.
MERCADOPAGO_PAGOS_STORE_ORIGIN=https://nubea.vercel.app
# Frecuencia (ms) del procesador de pagos.
MERCADOPAGO_PAGOS_DELAY_MS=5000
# Webhook de Orders: https://<backend>/api/publico/mercadopago/notificaciones
MERCADOPAGO_NOTIFICACIONES_ENABLED=false
# Clave secreta de la firma (x-signature) configurada en Mercado Pago. Obligatoria si las notificaciones están habilitadas.
MERCADOPAGO_NOTIFICACIONES_SECRET=

# --- Vencimiento de reservas (siempre activo, con o sin pagos). RN-M4-19 ---
# Frecuencia (ms) con la que se revisan los pedidos pendientes vencidos.
RESERVAS_VENCIMIENTO_DELAY_MS=60000
# Minutos tras el vencimiento antes de cancelar una creación de orden incierta (mayor que los 30 min de expiración de la orden).
RESERVAS_VENCIMIENTO_GRACIA_MINUTOS=40

# Frecuencia (ms) de la limpieza diferida de archivos en el almacenamiento.
STORAGE_CLEANUP_DELAY_MS=60000
