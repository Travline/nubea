# Variables de entorno de ejemplo; proporcionar secretos mediante el entorno de despliegue.
# Render define PORT automáticamente; local usa 8080 si no se configura.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Usar false únicamente en desarrollo local sin HTTPS.
SESSION_COOKIE_SECURE=true
# Para frontend en otro sitio: none, siempre con HTTPS y cookies Secure.
SESSION_COOKIE_SAME_SITE=lax
APP_CORS_ALLOWED_ORIGINS=
# Correo de una cuenta ya registrada; retirar tras inicializar el primer administrador.
APP_BOOTSTRAP_ADMIN_EMAIL=
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=nubea
# Base pública del CDN; en local, habilitar lectura pública únicamente en el bucket de desarrollo.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/nubea
MERCADOPAGO_OAUTH_ENABLED=false
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_OAUTH_AUTHORIZATION_URL=https://auth.mercadopago.com.pe/authorization
MERCADOPAGO_OAUTH_TOKEN_URL=https://api.mercadopago.com/oauth/token
MERCADOPAGO_OAUTH_CALLBACK_URL=
MERCADOPAGO_OAUTH_RETORNO_PANEL=http://localhost:3000/plataforma/panel/retorno-pago
MERCADOPAGO_OAUTH_EXPIRY_MINUTES=10
MERCADOPAGO_OAUTH_ACTIVE_KEY=k1
MERCADOPAGO_OAUTH_KEYS_K1=
